{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun run tooling bun run build:assets",
        "build:assets": "vp build",
        "build:ssr": "bun run tooling bun run build:ssr:assets",
        "build:ssr:assets": "vp build && vp build --ssr",
        "dev": "bun --no-env-file --bun node_modules/vite-plus/bin/vp dev --host 127.0.0.1 --port 5173 --strictPort",
        "dev:vite": "bun run dev",
        "dev:assets": "bun run dev",
        "tooling": "docker compose run --rm --no-deps tools",
        "check": "bun run tooling composer check",
        "check-types": "bun run tooling composer test:types",
        "routes:generate": "bun run tooling composer wayfinder:generate",
        "glados": "bun run env:check && bun run secrets:scan && bun run tooling composer glados",
        "shodan": "bun run tooling composer test:app",
        "shodan:ci": "bun run env:test && composer test",
        "test:browser": "bun run tooling composer test:browser",
        "env:host": "bun --no-env-file node_modules/varlock/bin/cli.js run --path .env.bootstrap.schema --inject vars --",
        "env:up": "bun run env:host docker compose up -d --no-build --pull never --wait --wait-timeout 60",
        "env:down": "docker compose down",
        "env:logs": "docker compose logs --follow --tail 100",
        "env:check": "bun run env:host docker compose run --rm --no-deps --entrypoint bun app --no-env-file node_modules/varlock/bin/cli.js load --path .env.schema",
        "env:unlock": "bun --no-env-file node_modules/varlock/bin/cli.js load --path .env.bootstrap.schema",
        "env:test": "bun --no-env-file test tests/Environment",
        "secrets:scan": "bun run env:host bun --no-env-file node_modules/varlock/bin/cli.js scan --path .env.schema",
        "secrets:scan:staged": "bun run secrets:scan --staged",
        "docker:build": "docker compose build",
        "docker:prepare": "bun install --frozen-lockfile && bun run docker:build && bun run docker:install && bun run build",
        "docker:test": "bun --no-env-file test tests/Docker",
        "docker:install": "bun run tooling composer install --no-interaction --prefer-dist --no-scripts && bun run tooling composer run-script post-autoload-dump",
        "docker:up": "bun run env:up",
        "docker:down": "bun run env:down",
        "docker:nuke": "docker compose down -v --remove-orphans",
        "docker:logs": "bun run env:logs",
        "docker:artisan": "bun run env:host docker compose run --rm --no-deps app php artisan",
        "lint": "NODE_OPTIONS='--experimental-strip-types' vp fmt resources/ && NODE_OPTIONS='--experimental-strip-types' vp lint --fix",
        "test:lint": "NODE_OPTIONS='--experimental-strip-types' vp fmt --check resources/ && NODE_OPTIONS='--experimental-strip-types' vp lint",
        "test:types": "tsc --noEmit && tsc --noEmit -p tests/Environment/tsconfig.json && tsc --noEmit -p tests/Docker/tsconfig.json"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@rolldown/plugin-babel": "^0.2.4",
        "@types/bun": "1.4.2",
        "@types/node": "^26.6.5",
        "npm-check-updates": "^23.1.0",
        "playwright": "^1.64.0",
        "tw-animate-css": "^1.4.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
        "vite-plus": "1.1.0"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.10",
        "@inertiajs/react": "^3.9.1",
        "@inertiajs/vite": "^3.9.1",
        "@laravel/passkeys": "^0.4.0",
        "@radix-ui/react-avatar": "^1.2.7",
        "@radix-ui/react-checkbox": "^1.3.12",
        "@radix-ui/react-collapsible": "^1.1.21",
        "@radix-ui/react-dialog": "^1.2.0",
        "@radix-ui/react-dropdown-menu": "^2.1.25",
        "@radix-ui/react-label": "^2.1.16",
        "@radix-ui/react-navigation-menu": "^1.3.0",
        "@radix-ui/react-select": "^2.3.8",
        "@radix-ui/react-separator": "^1.1.16",
        "@radix-ui/react-slot": "^1.4.0",
        "@radix-ui/react-toggle": "^1.1.19",
        "@radix-ui/react-toggle-group": "^1.1.20",
        "@radix-ui/react-tooltip": "^1.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@varlock/doppler-plugin": "2.0.2",
        "@vitejs/plugin-react": "^6.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.6",
        "input-otp": "^1.5.0",
        "laravel-vite-plugin": "^3.2.0",
        "lucide-react": "^1.55.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^7.0.2",
        "varlock": "1.22.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.5",
        "@rollup/rollup-linux-x64-gnu": "4.64.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.4.2",
            "onFail": "download"
        }
    }
}
