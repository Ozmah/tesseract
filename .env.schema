# Runtime contract: no plaintext secrets; the host supplies the bootstrap token.
# @defaultRequired=infer @defaultSensitive=true
# @cache=memory
# @currentEnv=$APP_ENV
# @plugin(@varlock/doppler-plugin)
# @initDoppler(project=tesseract, config=$APP_ENV, serviceToken=$DOPPLER_TOKEN)
# @setValuesBulk(dopplerBulk(), createMissing=false, omit=[APP_ENV, DOPPLER_TOKEN])
# ---

# @required @public @type=enum(local, production)
APP_ENV=
# @required @type=dopplerServiceToken @sensitive @internal
DOPPLER_TOKEN=
# @required @sensitive
APP_KEY=

# @public
APP_NAME=Tesseract
# @public @type=boolean
APP_DEBUG=false
# @public @type=url
APP_URL=http://localhost:8000
# @public
APP_LOCALE=en
# @public
APP_FALLBACK_LOCALE=en
# @public
LOG_CHANNEL=stderr
# @public
LOG_LEVEL=warning

# Metadata only; no database service or automatic migrations in this milestone.
# @public
DB_CONNECTION=sqlite
# @public
DB_DATABASE=/app-data/database.sqlite
# @public
SESSION_DRIVER=file
# @public @type=boolean
SESSION_ENCRYPT=true
# @public @type=boolean
SESSION_SECURE_COOKIE=if(forEnv(production), true, false)
# @public
CACHE_STORE=file
# @public
QUEUE_CONNECTION=sync
# @public
MAIL_MAILER=log
# @public
MAIL_FROM_ADDRESS=hello@example.com
# @public
MAIL_FROM_NAME=Tesseract
