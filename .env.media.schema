# Host-only MediaMTX configuration, kept separate from Laravel's runtime contract.
# @defaultRequired=true @defaultSensitive=true
# @cache=memory
# @import(./.env.media.local, allowMissing=true, pick=[DOPPLER_MEDIA_TOKEN])
# @plugin(@varlock/doppler-plugin)
# @initDoppler(project=tesseract, config=media-local, serviceToken=$DOPPLER_MEDIA_TOKEN)
# ---

# @type=dopplerServiceToken @internal
DOPPLER_MEDIA_TOKEN=

# @type=url(allowedProtocols=[rtsp, rtsps])
TESSERACT_CAMERA_TARS_RTSP_MAIN_URL=doppler()
# @type=url(allowedProtocols=[rtsp, rtsps])
TESSERACT_CAMERA_TARS_RTSP_SUB_URL=doppler()
# @type=url(allowedProtocols=[rtsp, rtsps])
TESSERACT_CAMERA_CASE_RTSP_MAIN_URL=doppler()
# @type=url(allowedProtocols=[rtsp, rtsps])
TESSERACT_CAMERA_CASE_RTSP_SUB_URL=doppler()
