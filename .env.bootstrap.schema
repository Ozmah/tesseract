# Host-only bootstrap: decrypt locally; never mount the local key into Docker.
# @defaultSensitive=true
# @cache=memory
# @import(./.env.local, allowMissing=true, pick=[DOPPLER_TOKEN])
# ---

# @required @public @type=enum(local, production)
APP_ENV=local

# Compose needs this token; only the runtime schema marks it internal.
# @required @sensitive
DOPPLER_TOKEN=
